[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="prop"
3d_physics/layer_3="player"
3d_physics/layer_4="enemy"
3d_physics/layer_5="enemy_hitbox"
3d_physics/layer_6="projectile"
3d_physics/layer_7="trigger"
3d_physics/layer_8="viewmodel"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
anti_aliasing/quality/msaa_3d=1
environment/volumetric_fog/volume_size=128
environment/volumetric_fog/volume_depth=96
occlusion_culling/use_occlusion_culling=true
